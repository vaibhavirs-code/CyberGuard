rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAnonymous() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == "anonymous";
    }

    function rolePath() {
      return /databases/$(database)/documents/roles/$(request.auth.uid);
    }

    function hasRole(role) {
      return isSignedIn() && exists(rolePath()) && get(rolePath()).data.role == role;
    }

    function isOperator() {
      return !isAnonymous() && (hasRole("operator") || hasRole("admin"));
    }

    function isAdmin() {
      return !isAnonymous() && hasRole("admin");
    }

    function isImmutableCreate(requiredFields) {
      return request.resource.data.keys().hasAll(requiredFields);
    }

    match /roles/{uid} {
      allow get: if request.auth.uid == uid;
      allow list, write: if false;
    }

    match /zoneLayouts/{zoneLayoutId} {
      allow get, list: if isOperator();
      allow create, update, delete: if isAdmin();

      match /zones/{zoneId} {
        allow get, list: if isOperator();
        allow create: if isAdmin() &&
          request.resource.data.zoneLayoutId == zoneLayoutId &&
          isImmutableCreate(["zoneLayoutId", "type", "label", "x", "y", "width", "height", "color"]);
        allow update: if isAdmin() &&
          request.resource.data.zoneLayoutId == resource.data.zoneLayoutId;
        allow delete: if isAdmin();
      }
    }

    match /videoSources/{videoSourceId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /customerTrackers/{customerTrackerId} {
      allow get, list: if isOperator();
      allow create: if isAdmin() &&
        isImmutableCreate(["id", "zone", "confidence", "lastSeen", "paymentState", "riskState"]);
      allow update, delete: if isAdmin();

      match /paymentSessions/{paymentSessionId} {
        allow get, list: if isOperator();
        allow create: if isAdmin() &&
          request.resource.data.customerTrackerId == customerTrackerId &&
          isImmutableCreate(["customerTrackerId", "method", "status", "initiatedAt"]);
        allow update: if isAdmin() &&
          request.resource.data.customerTrackerId == resource.data.customerTrackerId;
        allow delete: if isAdmin();
      }
    }

    match /eventLogs/{eventLogId} {
      allow get, list: if isOperator();
      allow create: if isAdmin() &&
        isImmutableCreate(["timestamp", "type", "description"]);
      allow update, delete: if false;
    }
  }
}
