rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CORE PHILOSOPHY
     * This ruleset implements a Role-Based Access Control (RBAC) model tailored for a retail monitoring system.
     * Access is bifurcated between 'System Administrators' (who manage configurations) and 'Authenticated 
     * Monitoring Users' (who view real-time data).
     * 
     * DATA STRUCTURE
     * - Configuration Data: /zoneLayouts and /videoSources are top-level collections for system setup.
     * - Operational Data: /customerTrackers and /eventLogs store real-time AI-generated insights.
     * - Hierarchical Dependencies: Zones are nested under ZoneLayouts, and PaymentSessions are nested under 
     *   CustomerTrackers to enforce structural integrity and simplify path-based authorization.
     * 
     * KEY SECURITY DECISIONS
     * 1. DBAC (Database-Based Access Control): Admin status is verified by checking the existence of a 
     *    document in the /roles_admin/{uid} collection.
     * 2. Monitoring Access: Any authenticated user (including anonymous users, as specified in the IR) 
     *    can read operational data to support real-time dashboards, but cannot modify it.
     * 3. System-Only Writes: Writes to tracking and logging collections are restricted to Admins. In a 
     *    production environment, this would typically be handled by Firebase Admin SDKs in backend services, 
     *    which bypass these rules.
     * 4. Relational Consistency: For nested resources, we enforce that the parent ID in the document 
     *    data matches the parent ID in the request path during creation.
     */

    // --- Helper Functions ---

    /** @description Checks if the request is from a signed-in user. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** @description Checks if the user has an admin record in the database. */
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /** @description Combines admin check with a verify-existence check for updates/deletes. */
    function isExistingAdmin() {
      return isAdmin() && resource != null;
    }

    // --- Collection Rules ---

    /**
     * @description Rules for global zone layouts used for store configuration.
     * @path /zoneLayouts/{zoneLayoutId}
     * @allow (get, list) if user is signed in.
     * @allow (create, update, delete) if user is an admin.
     * @deny (write) if user is not in the admin roles collection.
     * @principle Role-based configuration management.
     */
    match /zoneLayouts/{zoneLayoutId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin();
      allow update, delete: if isExistingAdmin();

      /**
       * @description Rules for specific zones within a layout.
       * @path /zoneLayouts/{zoneLayoutId}/zones/{zoneId}
       * @allow (create) if admin and data.zoneLayoutId matches the path.
       * @deny (create) if data.zoneLayoutId is mismatched with the path layout ID.
       * @principle Path-based relational integrity.
       */
      match /zones/{zoneId} {
        allow get, list: if isSignedIn();
        allow create: if isAdmin() && request.resource.data.zoneLayoutId == zoneLayoutId;
        allow update: if isExistingAdmin() && request.resource.data.zoneLayoutId == resource.data.zoneLayoutId;
        allow delete: if isExistingAdmin();
      }
    }

    /**
     * @description Management of video feed connections (RTSP, Webcams, etc).
     * @path /videoSources/{videoSourceId}
     * @allow (get, list) if signed in.
     * @allow (create, update, delete) if admin.
     * @deny (write) if not an admin.
     * @principle Restricted access to hardware connection strings.
     */
    match /videoSources/{videoSourceId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin();
      allow update, delete: if isExistingAdmin();
    }

    /**
     * @description Real-time customer tracking data generated by AI models.
     * @path /customerTrackers/{customerTrackerId}
     * @allow (get, list) if signed in (for monitoring dashboards).
     * @allow (create, update, delete) if admin (system service).
     * @deny (write) if non-admin user attempts to spoof tracker data.
     * @principle Public read for monitoring with restricted system-only writes.
     */
    match /customerTrackers/{customerTrackerId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin();
      allow update, delete: if isExistingAdmin();

      /**
       * @description Payment sessions associated with a specific tracked customer.
       * @path /customerTrackers/{customerTrackerId}/paymentSessions/{paymentSessionId}
       * @allow (create) if admin and customerTrackerId in data matches the path.
       * @deny (update) if attempting to change the associated customer ID.
       * @principle Relational immutability for transaction data.
       */
      match /paymentSessions/{paymentSessionId} {
        allow get, list: if isSignedIn();
        allow create: if isAdmin() && request.resource.data.customerTrackerId == customerTrackerId;
        allow update: if isExistingAdmin() && request.resource.data.customerTrackerId == resource.data.customerTrackerId;
        allow delete: if isExistingAdmin();
      }
    }

    /**
     * @description Audit logs for system events, zone entries, and errors.
     * @path /eventLogs/{eventLogId}
     * @allow (get, list) if signed in.
     * @allow (create) if admin (system service).
     * @deny (update, delete) even for admins, to preserve audit integrity (Append-only logic).
     * @principle Immutable audit trail.
     */
    match /eventLogs/{eventLogId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin();
      allow update, delete: if false; // Event logs should be immutable for audit purposes.
    }

    /**
     * @description Private collection used for Database-Based Access Control (DBAC).
     * @path /roles_admin/{uid}
     * @allow (get) if the user is checking their own admin status.
     * @deny (list, write) for all users via client SDK; managed via Admin SDK/Console.
     * @principle Security through isolation of authorization metadata.
     */
    match /roles_admin/{uid} {
      allow get: if request.auth.uid == uid;
      allow list, write: if false;
    }
  }
}